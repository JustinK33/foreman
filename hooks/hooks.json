{
  "description": "Foreman lifecycle hooks: refuse a write that contains a credential, refuse a commit that is two changes or an unreadable subject, flag an oversized diff, production code that arrived without a test, and comments that narrate instead of explain, and ask before finishing if the tests never ran.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bash >/dev/null 2>&1 && bash \"${CLAUDE_PLUGIN_ROOT}/hooks/no-secrets.sh\" || exit 0",
            "commandWindows": "if (Get-Command bash -ErrorAction SilentlyContinue) { bash \"$env:CLAUDE_PLUGIN_ROOT/hooks/no-secrets.sh\" }",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bash >/dev/null 2>&1 && bash \"${CLAUDE_PLUGIN_ROOT}/hooks/commit-check.sh\" || exit 0",
            "commandWindows": "if (Get-Command bash -ErrorAction SilentlyContinue) { bash \"$env:CLAUDE_PLUGIN_ROOT/hooks/commit-check.sh\" }",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bash >/dev/null 2>&1 && bash \"${CLAUDE_PLUGIN_ROOT}/hooks/after-edit.sh\" || exit 0",
            "commandWindows": "if (Get-Command bash -ErrorAction SilentlyContinue) { bash \"$env:CLAUDE_PLUGIN_ROOT/hooks/after-edit.sh\" }",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bash >/dev/null 2>&1 && bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-tests.sh\" || exit 0",
            "commandWindows": "if (Get-Command bash -ErrorAction SilentlyContinue) { bash \"$env:CLAUDE_PLUGIN_ROOT/hooks/session-tests.sh\" }",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v bash >/dev/null 2>&1 && bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-tests.sh\" || exit 0",
            "commandWindows": "if (Get-Command bash -ErrorAction SilentlyContinue) { bash \"$env:CLAUDE_PLUGIN_ROOT/hooks/session-tests.sh\" }",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v bash >/dev/null 2>&1 && bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-tests.sh\" || exit 0",
            "commandWindows": "if (Get-Command bash -ErrorAction SilentlyContinue) { bash \"$env:CLAUDE_PLUGIN_ROOT/hooks/session-tests.sh\" }",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
