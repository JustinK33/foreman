{
  "description": "Foreman lifecycle hooks: after each edit, flag an oversized diff and production code that arrived without a test.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bash >/dev/null 2>&1 && bash \"${CLAUDE_PLUGIN_ROOT}/hooks/after-edit.sh\" || exit 0",
            "commandWindows": "if (Get-Command bash -ErrorAction SilentlyContinue) { bash \"$env:CLAUDE_PLUGIN_ROOT/hooks/after-edit.sh\" }",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
